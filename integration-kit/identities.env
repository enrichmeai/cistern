# Identities the integration kit is built around. Demo values, committed on purpose:
# everything here is reachable from 127.0.0.1 only (ADR 0001) and exists to be read.
# Change nothing for a first run. Client secrets are also inside keycloak/realm-cistern.json;
# if you regenerate the realm, keep the two in step (keycloak/build-realm.sh reads this file).

# The pod owner (today's only server-side principal; authenticates with cistern.env's token).
CISTERN_OWNER_WEBID=https://acme-law.example/profile#firm

# Keycloak realm and its admin (dev mode).
KEYCLOAK_REALM=cistern
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Two humans. WebIDs travel in the `webid` claim (user attribute -> token claim).
KEYCLOAK_USER_ALICE=alice
KEYCLOAK_USER_ALICE_PASSWORD=alice-password
KEYCLOAK_USER_ALICE_WEBID=https://acme-law.example/people/alice#me
KEYCLOAK_USER_BOB=bob
KEYCLOAK_USER_BOB_PASSWORD=bob-password
KEYCLOAK_USER_BOB_WEBID=https://acme-law.example/people/bob#me

# Two service principals: confidential clients with service accounts (client-credentials).
# The service-account user carries the same `webid` attribute, so the claim is uniform.
KEYCLOAK_CLIENT_LEGAL_ID=valuedocs-legal
KEYCLOAK_CLIENT_LEGAL_SECRET=valuedocs-legal-secret-9d2c4f6a8b1e
KEYCLOAK_CLIENT_LEGAL_WEBID=https://valuedocs.example/apps/legal#id
KEYCLOAK_CLIENT_TAX_ID=valuedocs-tax
KEYCLOAK_CLIENT_TAX_SECRET=valuedocs-tax-secret-5e7a1c3b9f0d
KEYCLOAK_CLIENT_TAX_WEBID=https://valuedocs.example/apps/tax#id

# A third client that exists only to mint the *expired* fixture: 1-second access tokens.
KEYCLOAK_CLIENT_FIXTURE_ID=fixture-short-lived
KEYCLOAK_CLIENT_FIXTURE_SECRET=fixture-short-lived-secret-2b8e0f4d6c1a
KEYCLOAK_CLIENT_FIXTURE_WEBID=https://valuedocs.example/apps/fixture#id
KEYCLOAK_CLIENT_FIXTURE_TOKEN_LIFESPAN_SECONDS=1

# The audience every token carries (aud claim), and the issuer as Cistern must see it.
KEYCLOAK_AUDIENCE=cistern
KEYCLOAK_ISSUER=http://keycloak:8080/realms/cistern
