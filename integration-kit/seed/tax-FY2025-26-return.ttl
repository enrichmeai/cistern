@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix vd:      <https://valuedocs.example/ns#> .

# /tax/FY2025-26/return — a different container, therefore a different grant: the legal app
# is never granted here, and the kit's whole point is that it is refused here.
<#return> a vd:TaxReturn ;
    dcterms:identifier "FY2025-26" ;
    dcterms:title      "Corporation tax return, financial year 2025-26" ;
    dcterms:created    "2026-07-15"^^xsd:date ;
    vd:taxYearEnd      "2026-03-31"^^xsd:date ;
    vd:preparedFor     <https://acme-law.example/profile#firm> .
