# Environment the Cistern container gets (docker-compose.yml: env_file). Loopback only.
# Setting the owner is what turns enforcement ON: boot seeds /.acl for this WebID and
# nothing for anyone else. Same WebID as identities.env; keep the two in step.
CISTERN_OWNER_WEBID=https://acme-law.example/profile#firm
# Demo-only shared secret, presented as `Authorization: Bearer <token>`. It never leaves
# 127.0.0.1 and it is not a substitute for Solid-OIDC (Phase 4).
CISTERN_OWNER_TOKEN=kit-owner-token-3f9c1e0d7a4b2c6e
