<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.enrichmeai.cistern</groupId>
    <artifactId>cistern-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>cistern-wac</artifactId>
  <name>Cistern :: WAC</name>
  <description>Web Access Control engine: evaluates Authorization graphs. No Spring, no HTTP.</description>
  <dependencies>
    <dependency>
      <groupId>com.enrichmeai.cistern</groupId>
      <artifactId>cistern-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Authorizations arrive as a parsed graph; the engine reads Jena directly rather than
         re-modelling RDF. No Spring dependency here, as in cistern-core. -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
    </dependency>
    <!-- Declared rather than inherited by accident: slf4j-api reaches the classpath
         transitively through Jena, and a module that imports it in source should say so.
         Version comes from the spring-boot-dependencies BOM the parent imports. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The core test-jar (T1.2) publishes InMemoryResourceStore. Reused here so the ACL
         walk is exercised against the same reference store every backend is checked
         against, rather than against a second fake written for this module. -->
    <dependency>
      <groupId>com.enrichmeai.cistern</groupId>
      <artifactId>cistern-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- Publish src/test as a test-jar, as cistern-core does: InMemoryDecisionSink (T5.9)
             is the reference DecisionSink/DecisionQuery for tests in higher layers, so the
             HTTP tests observe receipts without touching disk. Consume with
             <type>test-jar</type> + <scope>test</scope>. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <id>wac-test-kit</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
