target/
data/
cth/reports/
.claude/worktrees/
# Terraform. .terraform.lock.hcl is deliberately NOT ignored — the provider
# versions it pins are what make a plan reproducible.
.terraform/
*.tfstate
*.tfstate.*
# Real values, which may name your own addresses. Commit the .example instead.
terraform.tfvars

*.iml
.idea/
.vscode/
.DS_Store
*.log
.env

# CTH IdP kit credentials — provisioned locally, never tracked
cth/idp/users.json

# BMAD Method. The framework itself is committed; these two are not — config.user.toml
# holds per-developer install answers, and _bmad-output is generated artefacts.
_bmad/config.user.toml
_bmad-output/

# Python bytecode. The BMAD skills ship .py scripts with tests; running them
# leaves caches inside the tracked skill directories.
__pycache__/
*.pyc
